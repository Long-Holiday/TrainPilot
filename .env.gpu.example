# ==============================================================================
# TrainPilot GPU 端服务器专属配置 (.env.gpu.example)
#
# 角色：深度学习训练节点 / AI Agent 客户端
# 部署机器：GPU 训练集群 / 内网服务器 (无需公网 IP，无外部依赖)
# 启动命令：./setup_skills.sh (运行环境: uv)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 控制面 Web 网关连接配置 (必须指向 Web 服务器公网 IP 或域名，严禁填 0.0.0.0)
# ------------------------------------------------------------------------------
# 方式一 (推荐): 直接填写 Web 服务器公网 IP 或域名，端口使用下方 TRAINPILOT_PORT
TRAINPILOT_HOST=35.202.16.245

# Web 网关监听端口 (默认 28780)
TRAINPILOT_PORT=28780

# 方式二: 直接填写完整网关 URL (若填写则优先级高于 HOST+PORT)
# TRAINPILOT_GATEWAY_URL=http://35.202.16.245:28780

# ------------------------------------------------------------------------------
# 2. 训练任务标识与通信鉴权
# ------------------------------------------------------------------------------
# 默认训练任务标识符 (可按具体训练项目命名，如 llama3-8b-sft、qwen2-7b-pretrain)
TRAINPILOT_TASK_ID=train-task-default

# 网关 API 鉴权 Token (必须与 Web 端服务器配置的 TRAINPILOT_API_TOKEN 一致；若 Web 端未开启鉴权可留空)
TRAINPILOT_API_TOKEN=
