# ==============================================================================
# TrainPilot Web 端服务器专属配置 (.env.web.example)
#
# 角色：控制面网关 (Control Plane Gateway)
# 部署机器：轻量公网云服务器 (有公网 IP 或域名，供内网 GPU 集群与飞书回调访问)
# 启动命令：./start.sh (运行环境: uv)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 服务绑定与网络监听
# ------------------------------------------------------------------------------
# Web 网关实际监听的网卡地址 (建议保持 0.0.0.0 监听本机所有网卡)
TRAINPILOT_BIND_HOST=0.0.0.0

# 兼容旧配置的 HOST 字段 (仅当值为 0.0.0.0/127.0.0.1 等本地地址时生效，建议使用 TRAINPILOT_BIND_HOST)
TRAINPILOT_HOST=0.0.0.0

# Web 网关监听端口 (默认采用小众高位端口 28780，规避 8000/8080 等常见端口冲突)
TRAINPILOT_PORT=28780

# 是否开启调试日志 (true / false)
TRAINPILOT_DEBUG=false

# 可选：对外公布的网关完整 URL (一般留空，由 HOST+PORT 自动拼接)
# TRAINPILOT_GATEWAY_URL=http://<本服务器公网IP或域名>:28780

# ------------------------------------------------------------------------------
# 2. 飞书机器人应用凭据 (对接飞书交互式卡片 HITL 决策闭环)
# ------------------------------------------------------------------------------
# 若未申请飞书应用或仅用于本地测试，可开启 MOCK 模式或留空凭据
TRAINPILOT_FEISHU_APP_ID=cli_a1b2c3d4e5f6
TRAINPILOT_FEISHU_APP_SECRET=your_feishu_app_secret_here
TRAINPILOT_FEISHU_VERIFICATION_TOKEN=your_feishu_verification_token
TRAINPILOT_FEISHU_ENCRYPT_KEY=

# 飞书告警/里程碑卡片推送目标
# 接收者类型: chat_id (群聊), open_id (个人), user_id, email
TRAINPILOT_FEISHU_RECEIVE_ID_TYPE=chat_id
# 目标群的 chat_id (如 oc_xxxx) 或个人的 open_id (ou_xxxx)
TRAINPILOT_FEISHU_RECEIVER_ID=oc_1234567890abcdef

# 是否强制开启 Mock 模式 (true: 仅在本地控制台打印卡片，不真实调用飞书开放平台)
TRAINPILOT_ENABLE_MOCK_FEISHU=false

# ------------------------------------------------------------------------------
# 3. 安全鉴权与跨域配置 (CORS)
# ------------------------------------------------------------------------------
# API 访问鉴权 Token (公网部署强烈建议设置；若设置，GPU 端必须携带相同的 Token；留空为开放模式)
TRAINPILOT_API_TOKEN=

# CORS 跨域配置 (* 表示全部允许；生产环境建议限制为具体前端控制台域名)
TRAINPILOT_CORS_ALLOW_ORIGINS=*
TRAINPILOT_CORS_ALLOW_CREDENTIALS=false

# ------------------------------------------------------------------------------
# 4. 可靠性、超时与持久化策略
# ------------------------------------------------------------------------------
# 训练任务心跳超时阈值 (秒)：超过该时间未收到心跳则标记为可能僵死
TRAINPILOT_TASK_HEARTBEAT_TIMEOUT_SECONDS=300

# 告警卡片决策超时 (秒)：超过该时间无人工在飞书点击则自动按“自行解决”恢复训练
TRAINPILOT_ALERT_DECISION_TIMEOUT_SECONDS=30

# HTTP 长轮询挂起等待时间上限 (秒)：客户端拉取指令时服务端挂起等待新决策的最大秒数
TRAINPILOT_LONG_POLL_TIMEOUT_SECONDS=20.0

# 每个任务最大保留历史事件数 (内存与 SQLite 环形缓冲区防 OOM)
TRAINPILOT_MAX_EVENTS_PER_TASK=500

# SQLite 本地持久化 (自动落盘，重启不丢状态与信箱)
TRAINPILOT_ENABLE_SQLITE=true
TRAINPILOT_SQLITE_PATH=trainpilot.db

# 服务端看门狗后台巡检 (定时巡检僵死失联任务并推送预警)
TRAINPILOT_ENABLE_WATCHDOG=true
TRAINPILOT_WATCHDOG_INTERVAL_SECONDS=15
