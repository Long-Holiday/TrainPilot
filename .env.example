# ==============================================================================
# TrainPilot 环境变量配置示例 (.env.example)
#
# 【架构说明】
# TrainPilot 采用现代化的 MCP 解耦架构：
# 1. 公网云服务器 (运行 ./start.sh):
#    作为 Model Context Protocol (MCP) Server 与 Web 控制面网关，
#    维护任务状态机、暴露 /sse 端点、对接飞书卡片 HITL 闭环。
# 2. 内网 GPU 节点 (运行训练代码 / trainpilot-cli / AI Agent):
#    无公网 IP，作为客户端 (MCP Client) 主动连接公网服务器。
#
# 【使用方法】
# 复制本文件为 .env: cp .env.example .env
# - 在公网服务器上部署时：配置 [模块一：公网服务端配置]
# - 在内网 GPU 节点上使用时：配置 [模块二：内网客户端配置]
# ==============================================================================


# ==============================================================================
# 模块一：公网服务端配置 (MCP Server / Web Gateway / ./start.sh)
# ==============================================================================
# 说明：仅在公网服务器上启动 MCP Server 时需要关注以下配置。

# 1. 网络监听与绑定
# 服务端监听网卡地址 (0.0.0.0 监听所有网卡)
TRAINPILOT_BIND_HOST=0.0.0.0
# 服务端监听端口 (默认 28780，采用高位端口规避冲突)
TRAINPILOT_PORT=28780
# 是否开启调试模式
TRAINPILOT_DEBUG=false

# 2. 飞书机器人应用凭据 (HITL 交互卡片与告警通知)
# 若未配置或开启 MOCK 模式，系统会自动在控制台打印卡片内容而不发起真实网络推送
TRAINPILOT_FEISHU_APP_ID=cli_a1b2c3d4e5f6
TRAINPILOT_FEISHU_APP_SECRET=your_feishu_app_secret_here
TRAINPILOT_FEISHU_VERIFICATION_TOKEN=your_feishu_verification_token
TRAINPILOT_FEISHU_ENCRYPT_KEY=

# 飞书卡片推送目标
# 接收者类型: chat_id (群聊), open_id (个人), user_id, email
TRAINPILOT_FEISHU_RECEIVE_ID_TYPE=chat_id
# 目标群聊 chat_id (如 oc_xxxx) 或个人 open_id (ou_xxxx)
TRAINPILOT_FEISHU_RECEIVER_ID=oc_1234567890abcdef
# 是否强制启用 Mock 模式 (true/false)
TRAINPILOT_ENABLE_MOCK_FEISHU=false

# 3. 安全鉴权与跨域设置
# API 访问鉴权 Token (公网暴露强烈建议设置；若设置，客户端需携带一致的 Token；留空为开放模式)
TRAINPILOT_API_TOKEN=
# 跨域来源允许列表 (* 为允许所有)
TRAINPILOT_CORS_ALLOW_ORIGINS=*
TRAINPILOT_CORS_ALLOW_CREDENTIALS=false

# 4. 可靠性与超时策略
# 任务心跳超时阈值 (秒)：超过此时间未上报心跳视为失联
TRAINPILOT_TASK_HEARTBEAT_TIMEOUT_SECONDS=300
# 异常告警等待人工决策超时时间 (秒)：超过该时间未决策将自动执行自愈决策
TRAINPILOT_ALERT_DECISION_TIMEOUT_SECONDS=30
# 客户端指令长轮询挂起超时时间 (秒)
TRAINPILOT_LONG_POLL_TIMEOUT_SECONDS=20.0
# 每个任务最多保留的事件历史数量
TRAINPILOT_MAX_EVENTS_PER_TASK=500

# 5. SQLite WAL 持久化与看门狗
# 是否启用 SQLite 持久化存储
TRAINPILOT_ENABLE_SQLITE=true
# 数据库存储文件路径
TRAINPILOT_SQLITE_PATH=trainpilot.db
# 任务与事件历史最长保留时长 (小时)
TRAINPILOT_TASK_RETENTION_HOURS=72
# 是否启动后台失联守护看门狗巡检
TRAINPILOT_ENABLE_WATCHDOG=true
# 看门狗巡检周期 (秒)
TRAINPILOT_WATCHDOG_INTERVAL_SECONDS=15


# ==============================================================================
# 模块二：内网 GPU 客户端配置 (Training Node / MCP Client / trainpilot-cli)
# ==============================================================================
# 说明：仅在内网训练节点或客户端上使用。内网节点无公网 IP，作为客户端主动发起连接。
# 核心注意：必须填写公网服务器的真实公网 IP 或域名，严禁配置为 0.0.0.0！

# 1. 公网 MCP Server 连接地址 (方式一或方式二选一)
# 方式一 (推荐): 指定公网服务端 IP/域名与端口 (默认拼接 http://{HOST}:{PORT})
TRAINPILOT_HOST=1.1.1.1
TRAINPILOT_PORT=28780

# 方式二: 指定完整 URL (若配置则优先级高于方式一)
# TRAINPILOT_GATEWAY_URL=http://1.1.1.1:28780

# 2. 默认训练任务标识与通信鉴权
# 当前训练任务唯一标识符 (例如 llama3-8b-lora, qwen2-7b-pretrain)
TRAINPILOT_TASK_ID=train-task-default
# 若公网服务端配置了 TRAINPILOT_API_TOKEN，此处必须填写完全一致的值
TRAINPILOT_API_TOKEN=
