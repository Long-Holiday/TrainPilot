# ==========================================
# TrainPilot Control Plane Gateway 配置示例
# ==========================================
# Web 服务器与 GPU 服务器必须分别配置 TRAINPILOT_HOST, 不可共用同一 .env:
#
# [Web 服务器 - 控制面网关, 运行 ./start.sh 的机器]
#   TRAINPILOT_HOST=0.0.0.0        # 绑定地址 (建议保持 0.0.0.0)
#   TRAINPILOT_BIND_HOST=          # 可选, Web 专用绑定覆盖 (优先级高于 HOST)
#   TRAINPILOT_PORT=28780
#   TRAINPILOT_GATEWAY_URL=        # 可选, 对外公布的完整网关地址 (留空则由 HOST+PORT 拼接)
#
# [GPU 服务器 - 训练内网机, 运行 Agent/Skill 的机器]
#   方式一 (推荐, 只填 HOST): TRAINPILOT_HOST=<Web公网IP/域名> (如 35.202.16.245)
#                            TRAINPILOT_PORT=28780
#   方式二 (完整 URL 优先):  TRAINPILOT_GATEWAY_URL=http://<Web公网IP/域名>:28780
#   注意: GPU 侧的 TRAINPILOT_HOST 表示"网关地址", 不是本机绑定地址, 不要填 0.0.0.0。
#
# 解析优先级 (代码: src/trainpilot/common/gateway.py):
#   网关地址 = $TRAINPILOT_GATEWAY_URL > http://$TRAINPILOT_HOST:$TRAINPILOT_PORT > http://127.0.0.1:28780
#   Web 绑定 = --host > $TRAINPILOT_BIND_HOST > $TRAINPILOT_HOST(仅本地值有效) > 0.0.0.0

# --- Web 侧绑定 (本示例为 Web 服务器配置) ---
TRAINPILOT_HOST=0.0.0.0
# TRAINPILOT_BIND_HOST 留空即使用上面的 HOST; 如需强制覆盖绑定地址可取消注释
# TRAINPILOT_BIND_HOST=0.0.0.0
TRAINPILOT_PORT=28780
TRAINPILOT_DEBUG=false

# GPU 侧如需直连, 可选设置完整网关地址 (留空则自动由 HOST+PORT 拼接; Web 侧一般留空)
# TRAINPILOT_GATEWAY_URL=http://127.0.0.1:28780

# 飞书应用凭据 (若不填或开启 MOCK，则默认进入本地 Mock/Log 模式，便于本地开发与单元测试)
TRAINPILOT_FEISHU_APP_ID=cli_a1b2c3d4e5f6
TRAINPILOT_FEISHU_APP_SECRET=your_feishu_app_secret_here
TRAINPILOT_FEISHU_VERIFICATION_TOKEN=your_feishu_verification_token
TRAINPILOT_FEISHU_ENCRYPT_KEY=

# 飞书告警卡片推送目标
# 接收者类型: chat_id (群聊), open_id (个人), user_id, email
TRAINPILOT_FEISHU_RECEIVE_ID_TYPE=chat_id
# 目标群的 chat_id (如 oc_xxxx) 或个人的 open_id (ou_xxxx)
TRAINPILOT_FEISHU_RECEIVER_ID=oc_1234567890abcdef

# 是否强制开启 Mock 模式 (true: 即使配置了凭据也只在本地打印卡片，不真实调飞书)
TRAINPILOT_ENABLE_MOCK_FEISHU=false

# 任务心跳超时判定时间 (秒)
TRAINPILOT_TASK_HEARTBEAT_TIMEOUT_SECONDS=300

# API 鉴权 (公网部署强烈建议设置；留空则为开放开发模式)
# 设置后 Agent 需携带 Authorization: Bearer <token> 或 X-API-Token，或配置 TRAINPILOT_API_TOKEN 环境变量
TRAINPILOT_API_TOKEN=

# CORS (逗号分隔，* 表示全部；生产建议收敛到控制台域名)
TRAINPILOT_CORS_ALLOW_ORIGINS=*
TRAINPILOT_CORS_ALLOW_CREDENTIALS=false

# 每个任务最多保留事件数 (环形裁剪防 OOM)
TRAINPILOT_MAX_EVENTS_PER_TASK=500
