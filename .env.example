# ==============================================================================
# TrainPilot 环境变量总览配置示例 (.env.example)
#
# 【架构与部署说明】
# TrainPilot 采用双端解耦架构，包含两类不同角色的服务器：
# 1. Web 端服务器 (运行 ./start.sh): 控制面网关，负责接收上报、维护状态机、对接飞书卡片
# 2. GPU 端服务器 (运行 ./setup_skills.sh): 训练内网机，负责模型训练与 Agent 异常上报/决策闭环
#
# 两台服务器需要填写的环境变量完全不同，请勿互相混淆！
# 本项目同时提供单独的文件模板：
#   - Web 端专属模板: .env.web.example (Web 服务器直接 cp .env.web.example .env)
#   - GPU 端专属模板: .env.gpu.example (GPU 服务器直接 cp .env.gpu.example .env)
# ==============================================================================


# ==============================================================================
# 模块一：Web 端服务器环境变量 (Web 控制面网关 / 运行 ./start.sh)
# ==============================================================================
# [说明]: 仅在 Web 端公网服务器上填写以下配置。GPU 端无需配置此模块中的内容！

# 1. 网络绑定与监听
TRAINPILOT_BIND_HOST=0.0.0.0
TRAINPILOT_HOST=0.0.0.0
TRAINPILOT_PORT=28780
TRAINPILOT_DEBUG=false

# 2. 飞书机器人应用凭据 (若不填或开启 MOCK 则进入本地 Mock 打印模式)
TRAINPILOT_FEISHU_APP_ID=cli_a1b2c3d4e5f6
TRAINPILOT_FEISHU_APP_SECRET=your_feishu_app_secret_here
TRAINPILOT_FEISHU_VERIFICATION_TOKEN=your_feishu_verification_token
TRAINPILOT_FEISHU_ENCRYPT_KEY=

# 飞书卡片推送目标
TRAINPILOT_FEISHU_RECEIVE_ID_TYPE=chat_id
TRAINPILOT_FEISHU_RECEIVER_ID=oc_1234567890abcdef
TRAINPILOT_ENABLE_MOCK_FEISHU=false

# 3. 安全鉴权与跨域配置
# API 鉴权 Token (公网暴露强烈建议设置；若设置，GPU 端需配置相同的值)
TRAINPILOT_API_TOKEN=
TRAINPILOT_CORS_ALLOW_ORIGINS=*
TRAINPILOT_CORS_ALLOW_CREDENTIALS=false

# 4. 可靠性与超时策略
TRAINPILOT_TASK_HEARTBEAT_TIMEOUT_SECONDS=300
TRAINPILOT_ALERT_DECISION_TIMEOUT_SECONDS=30
TRAINPILOT_LONG_POLL_TIMEOUT_SECONDS=20.0
TRAINPILOT_MAX_EVENTS_PER_TASK=500

# 5. 持久化与看门狗
TRAINPILOT_ENABLE_SQLITE=true
TRAINPILOT_SQLITE_PATH=trainpilot.db
TRAINPILOT_ENABLE_WATCHDOG=true
TRAINPILOT_WATCHDOG_INTERVAL_SECONDS=15


# ==============================================================================
# 模块二：GPU 端服务器环境变量 (训练节点 / AI Agent 技能 / 运行 ./setup_skills.sh)
# ==============================================================================
# [说明]: 仅在 GPU 端服务器上填写以下配置。Web 端无需配置此模块中的内容！
# 核心注意: GPU 端是客户端，必须填写 Web 服务器的公网 IP 或域名，千万不要写成 0.0.0.0！

# 1. 连接 Web 控制面网关地址 (方式一或方式二选一)
# 方式一: 指定 Web 端公网 IP/域名与端口
TRAINPILOT_HOST=35.202.16.245
TRAINPILOT_PORT=28780

# 方式二: 指定完整网关 URL (若配置则优先于方式一)
# TRAINPILOT_GATEWAY_URL=http://35.202.16.245:28780

# 2. 训练任务默认 ID 与通信鉴权
TRAINPILOT_TASK_ID=train-task-default
# 若 Web 端配置了 TRAINPILOT_API_TOKEN，此处必须填写完全一致的 Token
TRAINPILOT_API_TOKEN=
